# GROQ_API_KEY: Groq API key (gsk_...) for ultra-fast Groq LPU chat, vision, and Whisper transcription.
GROQ_API_KEY="MY_GROQ_API_KEY"

# POLLINATIONS_API_KEY: Pollinations API key (sk_...) for high-resolution raster image (PNG/JPEG) generation.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# HF_TOKEN: Hugging Face API token (hf_...) for real multi-instrument music generation.
HF_TOKEN="MY_HF_TOKEN"

# MAGIC_HOUR_API_KEY: Magic Hour API key (mhk_live_...) for AI video generation.
MAGIC_HOUR_API_KEY="MY_MAGIC_HOUR_API_KEY"

# GEMINI_API_KEY: Optional Gemini AI API key.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
